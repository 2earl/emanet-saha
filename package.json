{
  "name": "@2earl/emanet-saha",
  "version": "0.0.0",
  "private": true,
  "description": "Emanet Saha at saha.emanet.dev: the app for verified field agents who find vehicles with seizure orders and report them to the police.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  },
  "dependencies": {
    "hono": "4.13.21"
  }
}
