{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emanet-saha",
  // The 2earl Cloudflare account. An identifier, not a credential; deploys need only the token.
  "account_id": "304c2b77d734c688c8309d5a535f561a",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_als"],

  // Served at https://saha.emanet.dev: the custom domain is 2earl/emanet-core's
  // infra/worker.tf, attached once this Worker exists.
  "workers_dev": false,
  "preview_urls": false,

  // Invocation logs could record debtors' addresses and agents' locations.
  "observability": {
    "enabled": false,
  },

  "vars": {
    "SITE_ORIGIN": "https://saha.emanet.dev",
    "AUTHORIZATION_SERVER": "https://login.2earl.com",
  },

  "secrets": {
    "required": [
      // HMAC key for session and sign-in cookies (only HMACs are stored).
      "SESSION_PEPPER",
    ],
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  "services": [
    // Token exchange and validation for sign-in, never over the public Internet.
    { "binding": "AUTH_SERVER", "service": "login" },
    // Hunts, claims, sightings and evidence, as an agent may see and change them (emanet-core).
    { "binding": "CORE", "service": "emanet-core", "entrypoint": "FieldApi" },
  ],

  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "3002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  // Agents' photos and reports (docs/DESIGN.md §6, Found). EU jurisdiction, like the databases.
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "emanet-evidence", "jurisdiction": "eu" }],

  // Sessions and sign-in transactions only; everything else is in emanet-core.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emanet-saha",
      "database_id": "73a8df4c-6975-445f-9d64-993898d7cee5",
      "migrations_dir": "migrations",
    },
  ],
}
